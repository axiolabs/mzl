# ===== Obligatorias =====
# Cadena de conexión a PostgreSQL (nunca subas el valor real al repositorio)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE

# ===== Recomendadas en producción =====
# URL pública canónica (se usa en enlaces de correo y como origen permitido para CSRF)
APP_URL=
# Cookie Secure: auto (por defecto: https detectado) | always | never (sólo desarrollo)
COOKIE_SECURE=auto
# Área geográfica permitida: minLat,minLng,maxLat,maxLng (por defecto Manizales)
GEO_BOUNDS=4.98,-75.62,5.13,-75.38

# ===== Correo (opcional; sin esto los mensajes quedan en la tabla email_outbox) =====
RESEND_API_KEY=
EMAIL_FROM=

# ===== Cloudinary (opcional; sin esto las fotos se guardan en PostgreSQL) =====
# Sólo servidor. No uses prefijo NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
